{
  "name": "enginebox",
  "version": "0.3.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "pnpm build:rust && pnpm --filter enginebox-dashboard build",
    "build:rust": "cargo build --workspace --release --locked",
    "check": "cargo check --workspace --all-targets --locked && pnpm --filter enginebox-dashboard typecheck",
    "test": "cargo test --workspace --locked && pnpm --filter enginebox-dashboard test",
    "test:e2e": "pnpm --filter enginebox-dashboard test:e2e",
    "fmt": "cargo fmt --all",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "dev": "pnpm --filter enginebox-dashboard dev"
  }
}
