{
  "schema_version": 1,
  "id": "node24-windows-arm64",
  "label": "Node.js 24.22.1 (windows arm64)",
  "revision": 1,
  "os": "windows",
  "architecture": "arm64",
  "image": "node-24.22.1",
  "capabilities": [
    "node-24",
    "pwsh"
  ],
  "minimum": {
    "cpu": 1,
    "memory_mib": 256,
    "disk_mib": 512
  },
  "shell": "pwsh",
  "assets": [
    {
      "name": "node-archive",
      "url": "https://nodejs.org/dist/v24.22.1/node-v24.22.1-win-arm64.zip",
      "sha256": "a0c807319fede24c4a0d8f84564c82a619bd313b16b10c007c383c2609e99171",
      "max_bytes": 134217728
    }
  ],
  "install": "Copy-Item -LiteralPath ./assets/node-archive -Destination ./node.zip\nExpand-Archive -LiteralPath ./node.zip -DestinationPath .\nMove-Item -LiteralPath ./node-v24.22.1-win-arm64 -Destination ./toolchain\nRemove-Item ./node.zip",
  "verify": [
    {
      "capability": "node-24",
      "run": "& ./toolchain/node.exe --version",
      "expected_stdout": "v24.22.1"
    },
    {
      "capability": "pwsh",
      "run": "if ($PSVersionTable.PSVersion -lt [version]'7.3') { throw 'PowerShell 7.3+ required' }; Write-Output 'pwsh-ready'",
      "expected_stdout": "pwsh-ready"
    }
  ],
  "paths": [
    "toolchain"
  ],
  "timeout_minutes": 10
}
