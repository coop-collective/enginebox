{
  "version": 1,
  "projectId": "REPLACE_WITH_INFISICAL_PROJECT_UUID",
  "domain": "https://app.infisical.com",
  "targets": {
    "local": {
      "environment": "dev",
      "path": "/github"
    },
    "staging": {
      "environment": "staging",
      "path": "/github"
    },
    "production": {
      "environment": "production",
      "path": "/github"
    }
  },
  "secrets": {
    "ENGINEBOX_GITHUB_REPOS_CLIENT_SECRET": {
      "required": true,
      "generate": false,
      "rotation": "provider"
    },
    "ENGINEBOX_GITHUB_REPOS_PRIVATE_KEY": {
      "required": true,
      "generate": false,
      "rotation": "provider"
    },
    "ENGINEBOX_GITHUB_REPOS_WEBHOOK_SECRET": {
      "required": true,
      "generate": true,
      "rotation": "migration-required",
      "bytes": 32
    },
    "ENGINEBOX_GITHUB_RUNNERS_CLIENT_SECRET": {
      "required": true,
      "generate": false,
      "rotation": "provider"
    },
    "ENGINEBOX_GITHUB_RUNNERS_PRIVATE_KEY": {
      "required": true,
      "generate": false,
      "rotation": "provider"
    },
    "ENGINEBOX_GITHUB_RUNNERS_WEBHOOK_SECRET": {
      "required": true,
      "generate": true,
      "rotation": "migration-required",
      "bytes": 32
    }
  },
  "rotations": {}
}
