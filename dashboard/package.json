{
  "name": "enginebox-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/server.test.ts",
    "test:e2e": "playwright test"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
