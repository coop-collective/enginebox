# Managed by Engine Box control-plane installer v1
# Engine Box prefix: @PREFIX@
[Unit]
Description=Engine Box Vinext dashboard (loopback only)
After=network-online.target enginebox-fleet-api.service
Wants=network-online.target enginebox-fleet-api.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
Environment=NODE_ENV=production
EnvironmentFile=@PREFIX@/current/etc/dashboard.env
WorkingDirectory=@PREFIX@/current/dashboard
ExecStart=@NODE@ scripts/start.mjs
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
