// Engine Box Artifacts gateway: the shape of its Worker configuration.
// Deploys use the private file `pnpm configure` writes to
// .state/artifacts-gateway/wrangler.json (account and one Artifacts binding per
// provisioned project namespace). This committed file carries no account and
// serves local development only. The gateway has no hostname: the site Worker
// calls it over a service binding with entrypoint "ArtifactsGateway".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enginebox-artifacts-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-23",
  // Not reachable over HTTP: no route, no workers.dev, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // An Artifacts binding is bound to exactly one namespace. Namespaces are
  // `<NAMESPACE_PREFIX>-<project>`; NAMESPACES maps each to its binding.
  "artifacts": [{ "binding": "ARTIFACTS_0", "namespace": "enginebox-default" }],
  "vars": {
    "NAMESPACE_PREFIX": "enginebox",
    "NAMESPACES": "{\"enginebox-default\":\"ARTIFACTS_0\"}"
  },
  // Replay cache for request nonces (one instance).
  "durable_objects": { "bindings": [{ "name": "REPLAY", "class_name": "ReplayGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReplayGuard"] }],
  "observability": { "enabled": true }
  // GATEWAY_SECRET is a Worker secret: `pnpm secret` (never a var).
}
