{
  "name": "@enginebox/artifacts-gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE",
  "scripts": {
    "configure": "node configure.mjs",
    "check": "node --check src/gateway.mjs && node --check configure.mjs",
    "test": "node --test test/*.test.mjs",
    "dry-run": "wrangler deploy --dry-run --config ../../.state/artifacts-gateway/wrangler.json",
    "deploy": "wrangler deploy --config ../../.state/artifacts-gateway/wrangler.json",
    "secret": "wrangler secret put GATEWAY_SECRET --config ../../.state/artifacts-gateway/wrangler.json"
  },
  "devDependencies": { "wrangler": "4.152.0" }
}
