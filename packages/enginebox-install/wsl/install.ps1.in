# Release packaging replaces the two immutable rootfs placeholders below.
[CmdletBinding()]
param(
  [string]$Controller,
  [string]$EnrollmentCode,
  [long]$EnrollmentExpires=0,
  [int]$Cpu=0,
  [int]$MemoryGiB=0,
  [int]$DiskGiB=0,
  [switch]$Resume,
  [switch]$RegisterStartupTask,
  [string]$OwnerSid,
  [string]$InstallDirectory=(Join-Path $env:LOCALAPPDATA 'Enginebox\wsl-node')
)
$ErrorActionPreference='Stop'; Set-StrictMode -Version Latest
$DefaultController='https://enginebox.coopcollective.dev'
$Distro='Enginebox'
$TaskName='Enginebox WSL Node'
$SetupTaskName='Enginebox WSL Setup'
$Marker='Enginebox WSL2 schema 1'
function Assert-TaskOwner($Task,[string]$ExpectedOwnerSid) {
  if (-not $Task) { return }
  if ($Task.Description -ne $Marker) { throw 'An unrelated task owns an Enginebox task name.' }
  $owner=$Task.Principal.UserId
  if ($owner -notmatch '^S-1-[0-9-]+$') { $owner=[Security.Principal.NTAccount]::new($owner).Translate([Security.Principal.SecurityIdentifier]).Value }
  if ($owner -ne $ExpectedOwnerSid) { throw 'An Enginebox task belongs to a different Windows account.' }
}
function Register-RuntimeTask([string]$ExpectedOwnerSid) {
  $identity=[Security.Principal.WindowsIdentity]::GetCurrent()
  if ($identity.User.Value -ne $ExpectedOwnerSid) { throw 'Approve startup registration using the installing Windows account, not a different administrator.' }
  $existing=Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
  Assert-TaskOwner $existing $ExpectedOwnerSid
  $action=New-ScheduledTaskAction -Execute (Join-Path $env:WINDIR 'System32\wsl.exe') -Argument '--distribution Enginebox --user root --cd / --exec /usr/local/sbin/enginebox-wsl supervise'
  $boot=New-ScheduledTaskTrigger -AtStartup
  $boot.Delay='PT30S'
  $logon=New-ScheduledTaskTrigger -AtLogOn -User $ExpectedOwnerSid
  # Manual task starts do not reliably honor RestartOnFailure. A repeating
  # trigger also recovers clean exits and outages longer than the retry count.
  # IgnoreNew leaves the current supervisor and its workloads untouched.
  $recovery=New-ScheduledTaskTrigger -Once -At ((Get-Date).AddMinutes(1)) -RepetitionInterval (New-TimeSpan -Minutes 1)
  # S4U retains this user's WSL registration without storing a Windows password
  # or depending on an interactive desktop session. Workloads stay in Linux.
  $principal=New-ScheduledTaskPrincipal -UserId $ExpectedOwnerSid -LogonType S4U -RunLevel Limited
  $settings=New-ScheduledTaskSettingsSet -MultipleInstances IgnoreNew -ExecutionTimeLimit ([TimeSpan]::Zero) -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable
  Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger @($boot,$logon,$recovery) -Principal $principal -Settings $settings -Description $Marker -Force | Out-Null
}
function Enable-RuntimeStartup([string]$ExpectedOwnerSid,[string]$Script,[string]$Directory) {
  $identity=[Security.Principal.WindowsIdentity]::GetCurrent()
  $admin=[Security.Principal.WindowsPrincipal]::new($identity)
  if ($admin.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { Register-RuntimeTask $ExpectedOwnerSid; return }
  Write-Host 'Windows will request administrator approval to start this worker after a reboot, before sign-in. Use this same Windows account.'
  $arguments='-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{0}" -RegisterStartupTask -OwnerSid {1} -InstallDirectory "{2}"' -f $Script,$ExpectedOwnerSid,$Directory
  $process=Start-Process -FilePath (Join-Path $env:WINDIR 'System32\WindowsPowerShell\v1.0\powershell.exe') -ArgumentList $arguments -Verb RunAs -Wait -PassThru
  if ($process.ExitCode -ne 0) { throw 'Automatic startup registration failed. The runtime is retained; resume setup and approve startup registration using the same Windows account.' }
}
function Read-Number([string]$Label,[int]$Value,[int]$Default,[int]$Minimum,[int]$Maximum) {
  if ($Value -eq 0) { $inputValue=Read-Host "$Label [$Default]"; if (-not $inputValue) { $Value=$Default } elseif (-not [int]::TryParse($inputValue,[ref]$Value)) { throw "$Label must be a whole number." } }
  if ($Value -lt $Minimum -or $Value -gt $Maximum) { throw "$Label must be between $Minimum and $Maximum." }
  return $Value
}
function Assert-Origin([string]$Value) {
  $uri=$null
  if (-not [Uri]::TryCreate($Value,[UriKind]::Absolute,[ref]$uri) -or $uri.Scheme -ne 'https' -or $uri.UserInfo -or $uri.Query -or $uri.Fragment -or $uri.AbsolutePath -ne '/') { throw 'Controller must be an HTTPS origin without a path or credentials.' }
  return $uri.GetLeftPart([UriPartial]::Authority)
}
function Read-EnrollmentCode([string]$Value) {
  while ($true) {
    if ($Value) {
      $Value=$Value.Trim()
      if ($Value -cmatch '^[a-f0-9]{32}\.[a-f0-9]{64}$') { return $Value }
      Write-Host 'That is not a machine registration code. Paste only the dashboard Registration code field, not the dashboard password or the full install command. Installed components are retained.'
    }
    $secret=Read-Host 'One-time registration code' -AsSecureString
    $ptr=[Runtime.InteropServices.Marshal]::SecureStringToBSTR($secret)
    try { $Value=[Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr) } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr); $secret.Dispose() }
  }
}
function Protect-Directory([string]$Path) {
  $sid=[Security.Principal.WindowsIdentity]::GetCurrent().User
  $acl=New-Object Security.AccessControl.DirectorySecurity
  $acl.SetOwner($sid); $acl.SetAccessRuleProtection($true,$false)
  $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($sid,'FullControl','ContainerInherit,ObjectInherit','None','Allow')))
  Set-Acl -LiteralPath $Path -AclObject $acl
}
function Invoke-WslNative([string[]]$Arguments,[AllowNull()][string]$InputText=$null) {
  # Windows PowerShell 5.1 turns native stderr into ErrorRecords. Capture it
  # with Continue locally; judge the operation by its actual native exit code.
  # Keep stderr out of JSON probes and preserve secret input on stdin only.
  $previous=$ErrorActionPreference
  $PSNativeCommandUseErrorActionPreference=$false
  # Linux expects UTF-8 without a BOM, even if the parent PowerShell session
  # has selected another native-pipeline encoding.
  $OutputEncoding=[Text.UTF8Encoding]::new($false)
  $previousConsoleInput=[Console]::InputEncoding
  try {
    # .NET Framework creates and flushes Process.StandardInput using the
    # console encoding before PowerShell attaches its own writer. A UTF-8
    # console with a BOM would prepend it even with OutputEncoding above.
    [Console]::InputEncoding=$OutputEncoding
    $ErrorActionPreference='Continue'
    $items=if ($PSBoundParameters.ContainsKey('InputText')) { @($InputText | & wsl.exe @Arguments 2>&1) } else { @(& wsl.exe @Arguments 2>&1) }
    $code=$LASTEXITCODE
  } finally { $ErrorActionPreference=$previous; [Console]::InputEncoding=$previousConsoleInput }
  $stdout=@(); $stderr=@()
  foreach ($item in $items) {
    if ($item -is [System.Management.Automation.ErrorRecord]) { $stderr+=@($item.ToString()) }
    else { $stdout+=@([string]$item) }
  }
  return [pscustomobject]@{ExitCode=$code;Stdout=$stdout;Stderr=$stderr}
}
function Get-WslFailure($Result) {
  $detail=((@($Result.Stderr)+@($Result.Stdout)) -join "`n") -replace "`0",''
  $detail=($detail -replace '[a-fA-F0-9]{32}\.[a-fA-F0-9]{64}','[redacted credential]').Trim()
  if ($detail.Length -gt 4000) { $detail=$detail.Substring(0,4000) }
  if (-not $detail) { $detail='WSL returned no error output.' }
  return $detail
}
function Invoke-Wsl([string[]]$Arguments,[AllowNull()][string]$InputText=$null) {
  $result=if ($PSBoundParameters.ContainsKey('InputText')) { Invoke-WslNative -Arguments $Arguments -InputText $InputText } else { Invoke-WslNative -Arguments $Arguments }
  if ($result.ExitCode -ne 0) { throw "WSL operation failed (exit $($result.ExitCode)): $(Get-WslFailure $result)`nSetup and backups were retained; the installer can be resumed." }
  if ($result.Stderr.Count) { Write-Host ('WSL message (command succeeded): '+($result.Stderr -join "`n")) }
  $result.Stdout
}
function Get-WslVersion {
  if (-not (Get-Command wsl.exe -ErrorAction SilentlyContinue)) { return $null }
  $result=Invoke-WslNative -Arguments @('--version')
  if ($result.ExitCode -ne 0) { return $null }
  $value=($result.Stdout -join "`n") -replace "`0",''
  $match=[regex]::Match($value,'\d+\.\d+\.\d+')
  if ($match.Success) { return [version]$match.Value }
  return $null
}
function Get-RuntimeCapacity {
  # Read the actual Linux VM limits, not Windows physical RAM. This also works
  # with already-downloaded preview images, so failed setup can resume in place.
  $probe=@'
import json,os,pathlib
mem=int(next(l.split()[1] for l in pathlib.Path('/proc/meminfo').read_text().splitlines() if l.startswith('MemTotal:')))*1024
committed=any(pathlib.Path(p).exists() for p in ['/etc/enginebox/settings.json','/var/lib/enginebox/private/worker.json'])
print(json.dumps({'cpu':len(os.sched_getaffinity(0)),'memory_bytes':mem,'committed':committed}))
'@
  $raw=Invoke-Wsl -Arguments @('--distribution',$Distro,'--user','root','--cd','/','--exec','python3','-') -InputText $probe
  $capacity=($raw | Out-String) | ConvertFrom-Json
  if ($capacity.cpu -lt 1 -or $capacity.memory_bytes -le 0 -or $capacity.committed -isnot [bool]) { throw 'Invalid Linux resource inspection result.' }
  return $capacity
}
function Get-RuntimeIdentity {
  $probe=@'
import json,pathlib
p=pathlib.Path('/var/lib/enginebox/private/worker.json')
s=json.loads(p.read_text()) if p.exists() else {}
print(json.dumps({'id':s.get('id'),'enrolled':s.get('enrolled',False)}))
'@
  $raw=Invoke-Wsl -Arguments @('--distribution',$Distro,'--user','root','--cd','/','--exec','python3','-') -InputText $probe
  return (($raw | Out-String) | ConvertFrom-Json)
}
function Get-RuntimeImage([string]$Directory) {
  $image=Join-Path $Directory 'enginebox.wsl'
  [Net.ServicePointManager]::SecurityProtocol=[Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
  if (-not (Test-Path -LiteralPath $image) -or (Get-FileHash -Algorithm SHA256 -LiteralPath $image).Hash -ne '@@ROOTFS_SHA256@@') {
    Write-Host 'Downloading the preinstalled Linux runtime and templates...'
    Invoke-WebRequest -UseBasicParsing -Uri '@@ROOTFS_URL@@' -OutFile $image
  }
  if ((Get-FileHash -Algorithm SHA256 -LiteralPath $image).Hash -ne '@@ROOTFS_SHA256@@') { throw 'Linux image checksum mismatch.' }
  return $image
}
function Initialize-RuntimeOwnership([string]$Name,[string]$Location) {
  # A matching Windows registration path ties an interrupted import to this
  # private installation. Never adopt another distribution with the same name.
  $registrations=@(Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Lxss\*' -ErrorAction Stop | Where-Object { $_.DistributionName -eq $Name })
  if ($registrations.Count -ne 1) { throw 'Cannot identify the Enginebox WSL registration. Existing state was retained.' }
  $actual=[IO.Path]::GetFullPath(($registrations[0].BasePath -replace '^\\\\\?\\','')).TrimEnd('\')
  $expected=[IO.Path]::GetFullPath($Location).TrimEnd('\')
  if ($actual -ne $expected) { throw 'The Enginebox distribution is outside this installation directory. Existing state was retained.' }
  $owner=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value
  # Supply the non-secret SID as argv. Generate the claim's stdin inside Linux,
  # so first boot does not depend on a Windows PowerShell-to-WSL stdin pipe.
  $claim=@'
import pathlib,re,subprocess,sys
owner=sys.argv[1]
if not re.fullmatch(r'S-1-[0-9-]+',owner): sys.exit('Invalid Windows owner SID')
root=pathlib.Path('/etc/enginebox')
saved=root/'installation-owner'
if not (root/'wsl-runtime').is_file(): sys.exit('Not an Enginebox runtime')
if saved.is_symlink(): sys.exit('Ownership marker must not be a symlink')
if saved.exists():
    if saved.read_text().strip()!=owner: sys.exit('Enginebox belongs to a different Windows owner; state retained')
else:
    if (root/'settings.json').exists() or pathlib.Path('/var/lib/enginebox/private/worker.json').exists():
        sys.exit('Configured runtime has no ownership marker; state retained for inspection')
    result=subprocess.run(['/usr/local/sbin/enginebox-wsl','claim'],input=owner+'\n',text=True,capture_output=True)
    if result.returncode:
        sys.exit('Ownership claim exited '+str(result.returncode)+': '+(result.stderr or result.stdout or 'no Linux error output').strip())
    if not saved.is_file() or saved.read_text().strip()!=owner: sys.exit('Ownership claim did not persist the expected SID')
print(owner)
'@
  $encoded=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($claim))
  $entry="import base64;exec(base64.b64decode('$encoded'))"
  $result=Invoke-WslNative -Arguments @('--distribution',$Name,'--user','root','--cd','/','--exec','python3','-c',$entry,$owner)
  $confirmed=($result.Stdout -join "`n").Trim() -ceq $owner
  if ($result.ExitCode -ne 0 -or -not $confirmed) {
    throw "Could not record distribution ownership (exit $($result.ExitCode)): $(Get-WslFailure $result)`nThe installed runtime and backups were retained. Run this installer again to resume ownership setup."
  }
}
function Backup-AndRemoveRuntime([string]$Name,[string]$Directory) {
  # The caller must establish ownership and obtain the override choice first.
  # Export the stopped filesystem before unregistering, so credentials and LayerFS data
  # remain together in a private, recoverable backup.
  $owner=(Invoke-Wsl -Arguments @('--distribution',$Name,'--user','root','--cd','/','--exec','cat','/etc/enginebox/installation-owner') | Out-String).Trim()
  if ($owner -ne [Security.Principal.WindowsIdentity]::GetCurrent().User.Value) { throw 'Cannot replace a distribution without matching Enginebox ownership.' }
  $backupRoot=Join-Path $Directory 'backups'
  if ((Test-Path -LiteralPath $backupRoot) -and ((Get-Item -LiteralPath $backupRoot -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Backup directory must not be a junction or symlink.' }
  $backup=Join-Path $backupRoot (([DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss'))+'-'+[guid]::NewGuid().ToString('N'))
  New-Item -ItemType Directory -Path $backup -Force | Out-Null
  Protect-Directory $backup
  Write-Host "Backing up the existing Enginebox runtime to $backup"
  Invoke-Wsl -Arguments @('--distribution',$Name,'--user','root','--exec','systemctl','stop','enginebox-worker.service','enginebox-docker.service') | Out-Host
  Invoke-Wsl -Arguments @('--distribution',$Name,'--user','root','--exec','sync') | Out-Host
  Invoke-Wsl -Arguments @('--terminate',$Name) | Out-Host
  $disk=Join-Path $backup 'enginebox.tar'
  if (Test-Path -LiteralPath $disk) { throw 'The new backup path already exists; no state was removed.' }
  # TAR export works without shutting down the shared WSL VM. VHD export can
  # retain ERROR_SHARING_VIOLATION even after a distribution has terminated.
  $export=Invoke-WslNative -Arguments @('--export',$Name,$disk)
  if ($export.ExitCode -ne 0) {
    throw "Backup export failed (exit $($export.ExitCode)): $(Get-WslFailure $export)`nThe existing distribution was retained. Backup directory: $backup"
  }
  if (-not (Test-Path -LiteralPath $disk) -or (Get-Item -LiteralPath $disk).Length -lt 1MB) { throw "Backup is incomplete. The existing distribution was retained. Backup directory: $backup" }
  # Parse the entire archive without extracting private files onto Windows.
  # Stream names instead of keeping a potentially large file inventory in RAM.
  $required=@('etc/enginebox/installation-owner','etc/enginebox/wsl-runtime','usr/local/bin/enginebox-node','var/lib/enginebox')
  $seen=@{}
  $preference=$ErrorActionPreference
  try {
    $ErrorActionPreference='Continue'
    & tar.exe -tf $disk 2> (Join-Path $backup 'archive-validation.txt') | ForEach-Object {
      $entry=($_ -replace '^(\./|/)+','').TrimEnd('/')
      if ($required -ccontains $entry) { $seen[$entry]=$true }
    }
    $archiveExit=$LASTEXITCODE
  } finally { $ErrorActionPreference=$preference }
  if ($archiveExit -ne 0 -or $seen.Count -ne $required.Count) { throw "Backup archive validation failed. The existing distribution was retained. Backup directory: $backup" }
  $hash=(Get-FileHash -Algorithm SHA256 -LiteralPath $disk).Hash.ToLowerInvariant()
  @{schema=1;format='tar';distribution=$Name;sha256=$hash;bytes=(Get-Item -LiteralPath $disk).Length;created=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $backup 'backup.json') -Encoding UTF8
  $setup=Join-Path $Directory 'setup.json'
  if (Test-Path -LiteralPath $setup) { Copy-Item -LiteralPath $setup -Destination (Join-Path $backup 'setup.json') }
  Invoke-Wsl -Arguments @('--unregister',$Name) | Out-Host
  # WSL can retain an empty installation directory after unregistering. Move
  # any remainder into the backup rather than deleting files recursively.
  $oldDirectory=Join-Path $Directory 'distro'
  if (Test-Path -LiteralPath $oldDirectory) { Move-Item -LiteralPath $oldDirectory -Destination (Join-Path $backup 'installation-directory') }
  Write-Host "Previous identity and workspaces are preserved in $disk"
  return $backup
}
# Tests may load validation helpers without inspecting or modifying Windows.
if ($MyInvocation.InvocationName -eq '.') { return }
if ($env:OS -ne 'Windows_NT' -or -not [Environment]::Is64BitOperatingSystem -or $env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64') { throw 'This release requires Windows x64.' }
$root=[IO.Path]::GetFullPath($InstallDirectory)
for ($cursor=$root; $cursor; $cursor=Split-Path -Parent $cursor) {
  if ((Test-Path -LiteralPath $cursor) -and ((Get-Item -LiteralPath $cursor -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Installation path contains a junction or symlink.' }
  if ((Split-Path -Parent $cursor) -eq $cursor) { break }
}
if ($root.Contains('"')) { throw 'Installation path contains a quote.' }
$receiptPath=Join-Path $root 'setup.json'
$resumeScript=Join-Path $root 'install.ps1'
$existingTask=Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
$currentOwner=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value
Assert-TaskOwner $existingTask $currentOwner
$existingSetupTask=Get-ScheduledTask -TaskName $SetupTaskName -ErrorAction SilentlyContinue
Assert-TaskOwner $existingSetupTask $currentOwner
$settings=$null
if (Test-Path -LiteralPath $receiptPath) {
  $settings=Get-Content -Raw -LiteralPath $receiptPath | ConvertFrom-Json
  if ($settings.marker -ne $Marker -or $settings.root -ne $root) { throw 'Installation ownership mismatch.' }
  if (-not $Controller) { $Controller=$settings.controller }
  if (-not $Cpu) { $Cpu=$settings.cpu }; if (-not $MemoryGiB) { $MemoryGiB=$settings.memory_gib }; if (-not $DiskGiB) { $DiskGiB=$settings.disk_gib }
} elseif ((Test-Path -LiteralPath $root) -and @(Get-ChildItem -LiteralPath $root -Force).Count) { throw 'Installation directory is not empty and has no Enginebox receipt.' }
if ($RegisterStartupTask) {
  if (-not $settings -or -not $OwnerSid) { throw 'Startup registration requires an existing owned installation and its Windows owner.' }
  Register-RuntimeTask $OwnerSid
  return
}
if (-not $Controller) { $Controller=$DefaultController }
$codeController=Assert-Origin $Controller
if (-not $settings) { $chosen=Read-Host "Controller address [$Controller]"; if ($chosen) { $Controller=$chosen } }
$Controller=Assert-Origin $Controller
if ($EnrollmentCode -and $Controller -ne $codeController) {
  $EnrollmentCode=$null; $EnrollmentExpires=0
  Write-Host 'The supplied registration code belongs to the original controller. Setup will ask for a fresh code from the selected controller.'
}
$computer=Get-CimInstance Win32_ComputerSystem
$cores=[int]$computer.NumberOfLogicalProcessors
$memory=[int][math]::Floor([double]$computer.TotalPhysicalMemory/1GB)
$drive=[IO.DriveInfo]::new([IO.Path]::GetPathRoot($root))
$free=[int][math]::Floor($drive.AvailableFreeSpace/1GB)
if ($memory -lt 6 -or (-not $settings -and $free -lt 25)) { throw 'At least 6 GiB physical RAM and 25 GiB free disk are required for a new installation.' }
$Cpu=Read-Number 'CPU cores to contribute' $Cpu ([math]::Max(1,[math]::Min(4,[math]::Floor($cores/2)))) 1 ([math]::Min(256,$cores))
$MemoryGiB=Read-Number 'Memory allowance in GiB' $MemoryGiB ([math]::Max(4,[math]::Min(8,[math]::Floor($memory/2)))) 4 ([math]::Min(4096,$memory-2))
# Existing VHD allocations already consume host free space. Resumption retains
# the original maximum instead of requiring that capacity a second time.
$diskMaximum=if ($settings) { [int]$settings.disk_gib } else { [math]::Min(65536,[math]::Max(20,$free-5)) }
$DiskGiB=Read-Number 'Linux disk maximum in GiB (includes templates)' $DiskGiB ([math]::Max(20,[math]::Min(50,[math]::Floor($free/2)))) 20 $diskMaximum
if ($settings -and ($settings.controller -ne $Controller -or $settings.cpu -ne $Cpu -or $settings.memory_gib -ne $MemoryGiB -or $settings.disk_gib -ne $DiskGiB)) { throw 'Existing installation has different settings. This installer preserves its identity, resources and workspaces.' }
New-Item -ItemType Directory -Force -Path $root | Out-Null; Protect-Directory $root
$installationLock=[IO.File]::Open((Join-Path $root 'install.lock'),[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)
try {
if ($PSCommandPath -ne $resumeScript) { Copy-Item -LiteralPath $PSCommandPath -Destination $resumeScript -Force }
function Save-Setup {
  @{marker=$Marker;root=$root;controller=$Controller;cpu=$Cpu;memory_gib=$MemoryGiB;disk_gib=$DiskGiB} | ConvertTo-Json | Set-Content -LiteralPath $receiptPath -Encoding UTF8
}
Save-Setup
# Keep resumption under the installing user. Elevation is limited to enabling
# WSL; the distro and identity must not accidentally belong to another admin.
$sid=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value
$action=New-ScheduledTaskAction -Execute 'powershell.exe' -Argument ('-NoProfile -ExecutionPolicy Bypass -File "{0}" -Resume' -f $resumeScript)
$trigger=New-ScheduledTaskTrigger -AtLogOn -User $sid
$principal=New-ScheduledTaskPrincipal -UserId $sid -LogonType Interactive -RunLevel Limited
# Pending setup must never replace a registered worker's action or retry policy.
# An interruption or declined override leaves the runtime task intact.
Register-ScheduledTask -TaskName $SetupTaskName -Action $action -Trigger $trigger -Principal $principal -Description $Marker -Force | Out-Null
if (-not (Get-Command wsl.exe -ErrorAction SilentlyContinue)) {
  # Older Windows installations may omit the WSL launcher until its optional
  # component is enabled. Only the Windows feature operation is elevated.
  foreach ($feature in @('Microsoft-Windows-Subsystem-Linux','VirtualMachinePlatform')) {
    $enable=Start-Process -FilePath 'dism.exe' -ArgumentList @('/online','/enable-feature',('/featurename:'+$feature),'/all','/norestart') -Verb RunAs -Wait -PassThru
    if ($enable.ExitCode -notin @(0,3010,1641)) { throw "Windows could not enable $feature (exit $($enable.ExitCode))." }
  }
  Write-Host 'Restart Windows to finish enabling WSL. Setup resumes at your next sign-in.'
  exit 3010
}
$wslVersion=Get-WslVersion
if (-not $wslVersion -or $wslVersion -lt [version]'2.5.7') {
  Write-Host 'Installing/updating WSL2. Windows may request administrator approval.'
  if (-not $wslVersion) {
    $install=Start-Process -FilePath 'wsl.exe' -ArgumentList '--install --no-distribution --web-download' -Verb RunAs -Wait -PassThru
    if ($install.ExitCode -in @(3010,1641)) { Write-Host 'Restart Windows. Setup resumes at your next sign-in.'; exit 3010 }
    if ($install.ExitCode -ne 0) { throw "WSL installation failed (exit $($install.ExitCode))." }
  }
  $update=Start-Process -FilePath 'wsl.exe' -ArgumentList '--update --web-download' -Verb RunAs -Wait -PassThru
  if ($update.ExitCode -notin @(0,3010,1641)) { throw "WSL update failed (exit $($update.ExitCode))." }
  if ($update.ExitCode -in @(3010,1641)) { Write-Host 'Restart Windows. Setup resumes at your next sign-in.'; exit 3010 }
  $wslVersion=Get-WslVersion
  if (-not $wslVersion -or $wslVersion -lt [version]'2.5.7') { throw 'WSL 2.5.7 or newer is required. The WSL update has not taken effect; restart Windows and resume setup.' }
}
$wslStatus=Invoke-WslNative -Arguments @('--status')
if ($wslStatus.ExitCode -ne 0) {
  $enable=Start-Process -FilePath 'wsl.exe' -ArgumentList '--install --no-distribution --web-download' -Verb RunAs -Wait -PassThru
  if ($enable.ExitCode -notin @(0,3010,1641)) { throw "WSL could not enable its Windows prerequisites (exit $($enable.ExitCode)). Check the Windows error above, including firmware virtualization if reported." }
  Write-Host 'WSL prerequisites were enabled. Restart Windows, then setup resumes at your next sign-in. If Windows still reports a virtualization error, enable hardware virtualization in firmware. The machine has not registered yet.'
  exit 3010
}
$distros=@((Invoke-Wsl -Arguments @('--list','--quiet')) | ForEach-Object { ($_ -replace "`0",'').Trim() })
$hasDistro=$distros -contains $Distro
if ($hasDistro) {
  Initialize-RuntimeOwnership $Distro (Join-Path $root 'distro')
  if (-not $Resume) {
    Write-Host 'An Enginebox installation already exists. Override stops this runtime, saves its complete state in a private backup, and installs a fresh runtime for registration.'
    $choice=Read-Host 'Override existing? [Y/n]'
    if ($choice -and $choice -notmatch '^(?i:y|yes|n|no)$') { throw 'Enter Y to override or N to continue the existing installation.' }
    if (-not $choice -or $choice -match '^(?i:y|yes)$') {
      if ($EnrollmentCode -and $EnrollmentCode.Trim() -cnotmatch '^[a-f0-9]{32}\.[a-f0-9]{64}$') { throw 'Invalid registration code. Copy a fresh install command from the dashboard. The existing runtime was retained.' }
      $identity=Get-RuntimeIdentity
      if ($identity.enrolled -and $EnrollmentCode -and $EnrollmentCode.Split('.')[0] -eq $identity.id) { throw 'This code belongs to the enrolled runtime. Create an install command for a new machine before overriding. The existing runtime was retained.' }
      # Download and verify the replacement before stopping the old runtime.
      if (-not (Get-Command tar.exe -ErrorAction SilentlyContinue)) { throw 'Windows tar.exe is required to verify the backup. The existing runtime was retained.' }
      $null=Get-RuntimeImage $root
      try {
        if ($existingTask) {
          # A recovery trigger must not restart the runtime during its export.
          Disable-ScheduledTask -TaskName $TaskName | Out-Null
          Stop-ScheduledTask -TaskName $TaskName
        }
        $null=Backup-AndRemoveRuntime $Distro $root
      } catch {
        $failure=$_
        try {
          $remaining=Invoke-WslNative -Arguments @('--list','--quiet')
          $names=@($remaining.Stdout | ForEach-Object { ($_ -replace "`0",'').Trim() })
          if ($existingTask -and $existingTask.Settings.Enabled -and $remaining.ExitCode -eq 0 -and $names -contains $Distro) {
            Enable-ScheduledTask -TaskName $TaskName | Out-Null
            if ($existingTask.State -eq 'Running') { Start-ScheduledTask -TaskName $TaskName }
          }
        } catch { Write-Warning 'Could not restore the previous startup task; resume the retained installer.' }
        throw $failure
      }
      $hasDistro=$false
    }
  }
}
if (-not $hasDistro) {
  $image=Get-RuntimeImage $root
  Invoke-Wsl -Arguments @('--install','--from-file',$image,'--name',$Distro,'--location',(Join-Path $root 'distro'),'--version','2','--vhd-size',($DiskGiB.ToString()+'GB'),'--no-launch')
  Initialize-RuntimeOwnership $Distro (Join-Path $root 'distro')
  Remove-Item -LiteralPath $image -Force
}
$capacity=Get-RuntimeCapacity
# Match the runtime's 512 MiB kernel-overhead tolerance when converting its
# MemTotal observation back to whole-GiB allowances (e.g. a 4 GiB WSL VM).
$linuxMemory=[int][math]::Floor(([double]$capacity.memory_bytes+512MB)/1GB)
$linuxCpu=[int]$capacity.cpu
$observedMemory=[math]::Round([double]$capacity.memory_bytes/1GB,2)
Write-Host "WSL reports $linuxCpu CPU cores and $observedMemory GiB usable RAM."
if ($linuxMemory -lt 4) {
  throw "WSL has only $observedMemory GiB usable RAM; Enginebox requires a WSL memory limit of at least 4 GiB. Increase Memory size in WSL Settings (or the existing [wsl2] memory setting in $env:USERPROFILE\.wslconfig), save work in all WSL distributions, restart Windows, and rerun this installer. The installed image is retained. Global WSL settings were not changed."
}
if ($Cpu -gt $linuxCpu -or $MemoryGiB -gt $linuxMemory) {
  if ($capacity.committed) {
    throw "WSL capacity is below this installation's saved allowance ($Cpu CPU, $MemoryGiB GiB). Restore its WSL limits and restart Windows after saving work, then resume. Existing settings, identity and workspaces were preserved."
  }
  Write-Host 'The requested allowance exceeds WSL capacity. Choose a smaller allowance to finish this pending installation.'
  if ($Cpu -gt $linuxCpu) { $Cpu=Read-Number 'CPU cores within WSL capacity' 0 $linuxCpu 1 $linuxCpu }
  if ($MemoryGiB -gt $linuxMemory) { $MemoryGiB=Read-Number 'Memory allowance within WSL capacity in GiB' 0 $linuxMemory 4 $linuxMemory }
  # Only an unconfigured, identity-free runtime can change its pending budget.
  # The Linux configure command independently refuses changes to saved settings.
  Save-Setup
}
$configuration=@{controller=$Controller;cpu=$Cpu;memory_gib=$MemoryGiB;disk_gib=$DiskGiB} | ConvertTo-Json -Compress
Invoke-Wsl -Arguments @('--distribution',$Distro,'--user','root','--cd','/','--exec','/usr/local/sbin/enginebox-wsl','configure') -InputText $configuration
$enrollmentStatus=Invoke-WslNative -Arguments @('--distribution',$Distro,'--user','root','--cd','/','--exec','/usr/local/sbin/enginebox-wsl','enrolled')
if ($enrollmentStatus.ExitCode -notin @(0,1)) { throw "Could not inspect registration: $(Get-WslFailure $enrollmentStatus)" }
$registered=$enrollmentStatus.ExitCode -eq 0
while (-not $registered) {
  if ($EnrollmentExpires -gt 0 -and [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -ge $EnrollmentExpires) { $EnrollmentCode=$null; Write-Host 'The original registration code expired during setup. Generate a fresh code; installed components are retained.' }
  $identity=Get-RuntimeIdentity
  if ($identity.id) { Write-Host "Saved machine ID: $($identity.id). Renew the registration code on this exact machine card in the dashboard." }
  if (-not $EnrollmentCode) { Write-Host "Open $Controller/dashboard/ and copy the Registration code for an installer already open field." }
  $EnrollmentCode=Read-EnrollmentCode $EnrollmentCode
  if ($identity.id -and $EnrollmentCode.Split('.')[0] -ne $identity.id) { throw "The registration code is for a different machine. Saved machine ID: $($identity.id). Rerun this installer and choose Override existing, or renew the code for that exact ID in the dashboard. State was retained." }
  try {
    $registration=Invoke-WslNative -Arguments @('--distribution',$Distro,'--user','root','--cd','/','--exec','/usr/local/sbin/enginebox-wsl','enroll') -InputText $EnrollmentCode
  } finally { $EnrollmentCode=$null }
  if ($registration.ExitCode -ne 0) {
    $detail=Get-WslFailure $registration
    $detail | Set-Content -LiteralPath (Join-Path $root 'registration-error.txt') -Encoding UTF8
    Write-Host "Registration failed: $detail`nState is retained. Error details: $(Join-Path $root 'registration-error.txt')"
    $choice=Read-Host 'Retry registration without reinstalling? [Y/n]'
    if ($choice -and $choice -notmatch '^(?i:y|yes)$') { throw "Registration failed: $detail`nResume the saved installer with -Resume to retry without reinstalling. State is retained." }
    $EnrollmentExpires=0
    continue
  }
  $registered=$true
}
Enable-RuntimeStartup $sid $resumeScript $root
Start-ScheduledTask -TaskName $TaskName
Unregister-ScheduledTask -TaskName $SetupTaskName -Confirm:$false
Write-Host "Registered. WSL2 owns the Linux runtime and template workspaces: $Cpu CPU, $MemoryGiB GiB memory, $DiskGiB GiB virtual disk maximum."
Write-Host 'Automatic startup is configured for boot and sign-in; the worker retries failures every minute without a runtime time limit.'
Write-Host "Agent tools are inside templates; sign in through an authorized workspace. Dashboard: $Controller/dashboard/"
} finally { $installationLock.Dispose() }
