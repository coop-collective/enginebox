{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine Box controller deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "remote_node", "controller", "templates"],
  "properties": {
    "schema_version": { "const": 1 },
    "target": { "const": "x86_64-unknown-linux-gnu" },
    "remote_node": { "$ref": "#/$defs/path" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "installer", "supervisor_config", "state_dir", "token_file", "url"],
      "properties": {
        "prefix": { "$ref": "#/$defs/path" },
        "installer": { "$ref": "#/$defs/path", "description": "Existing pinned enginebox-install binary inside prefix/releases." },
        "supervisor_config": { "$ref": "#/$defs/path" },
        "state_dir": { "$ref": "#/$defs/path" },
        "token_file": { "$ref": "#/$defs/path" },
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$" }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "allow_ids", "files", "timeout_seconds"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,48}$" },
        "allow_ids": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,48}$" } },
        "files": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^templates/[a-z0-9][a-z0-9-]*\\.json$" } },
        "timeout_seconds": { "type": "integer", "minimum": 15, "maximum": 7200 }
      }
    }
  },
  "$defs": { "path": { "type": "string", "pattern": "^/[A-Za-z0-9_./-]+$", "description": "Absolute Linux path; executable validation additionally rejects dot/parent/empty components and symlinks." } }
}
